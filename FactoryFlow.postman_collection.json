              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"karim@factoryflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
