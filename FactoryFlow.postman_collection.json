    {
      "name": "6. Ordres de Fabrication (Workflow Complet)",
      "item": [
        {
          "name": "6.1 Créer un Ordre de Fabrication (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"OF-2026-001\",\n  \"productId\": \"{{productId}}\",\n  \"assignedOperatorId\": \"{{operatorId}}\",\n  \"quantityToProduce\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/production-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "production-orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ordre créé (201)', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "var id = (json.data && (json.data._id || json.data.id)) || json._id || json.id;",
                  "if (id) {",
                  "    pm.collectionVariables.set('orderId', id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "6.2 Modifier l'ordre encore planifié (Admin - passe à 12 unités)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityToProduce\": 12\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/production-orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "production-orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ordre planifié modifié avec succès (200)', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "6.3 Consulter les ordres avec filtres & pagination (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/production-orders?status=PLANIFIE&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "production-orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PLANIFIE"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Liste paginée retournée (200)', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.data.pagination).to.have.property('totalPages');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "6.4 Consulter les ordres en tant qu'Opérateur (Cloisonnement)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/production-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "production-orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('L opérateur ne voit que ses ordres (200)', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "6.5 Démarrer l'ordre (Opérateur - Déduction atomique du stock)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/production-orders/{{orderId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "production-orders",
                "{{orderId}}",
                "start"
