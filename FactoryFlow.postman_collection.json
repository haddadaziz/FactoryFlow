                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Connexion Opérateur réussie (200)', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var token = (json.data && json.data.token) ? json.data.token : json.token;",
                  "if (token) {",
