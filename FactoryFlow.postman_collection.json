              "raw": "{\n  \"reference\": \"PROD-DOUBLON\",\n  \"name\": \"Produit Invalide\",\n  \"composition\": [\n    {\n      \"materialId\": \"{{materialAId}}\",\n      \"quantity\": 2\n    },\n    {\n      \"materialId\": \"{{materialAId}}\",\n      \"quantity\": 3\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
