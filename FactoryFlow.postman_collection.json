{
  "info": {
    "name": "FactoryFlow API - Demo",
    "description": "Collection complète pour la démonstration de FactoryFlow (Installation, Authentification RBAC, Stocks, Produits, Ordres de fabrication, Cohérence transactionnelle ACID).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "operatorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "operatorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "materialAId",
      "value": "",
      "type": "string"
    },
    {
      "key": "materialBId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Installation One-Shot",
      "item": [
        {
          "name": "1.1 Vérifier le statut d'installation (Non installé)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/installation/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "installation",
                "status"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Application non encore installée', function () {",
                  "    var json = pm.response.json();",
                  "    var installed = (json.data && json.data.isInstalled !== undefined) ? json.data.isInstalled : json.isInstalled;",
                  "    pm.expect(installed).to.eql(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Initialiser l'application (Créer le premier Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Directeur Usine\",\n  \"email\": \"admin@factoryflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/installation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "installation"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Premier Admin créé', function () {",
                  "    var json = pm.response.json();",
                  "    var admin = (json.data && json.data.admin) ? json.data.admin : json.admin;",
                  "    pm.expect(admin.role).to.eql('admin');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3 Tentative de réinstallation (Doit échouer 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hacker\",\n  \"email\": \"hacker@factoryflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/installation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "installation"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Réinstallation refusée avec code 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentification",
      "item": [
        {
          "name": "2.1 Connexion Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@factoryflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Connexion Admin réussie (200)', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var token = (json.data && json.data.token) ? json.data.token : json.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set('adminToken', token);",
                  "    console.log('Admin Token saved successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 Consulter son profil (Admin Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Profil Admin récupéré (200)', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
